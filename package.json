{
  "name": "dnschecker",
  "version": "1.0.0",
  "description": "Real-time DNS, mail & security diagnostics — Cloudflare Pages + HTMX + Tailwind",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public",
    "pages:create": "wrangler pages project create domain-dns-dnschecker --production-branch=main",
    "deploy": "wrangler pages deploy public --project-name=domain-dns-dnschecker"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "wrangler": "^3.114.17"
  }
}
